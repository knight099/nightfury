# App
APP_NAME=nightwatch-api
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# Database
DATABASE_URL=postgresql+asyncpg://nightwatch:nightwatch@localhost:5432/nightwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# GCS
GCS_BUCKET=nightwatch-events
GCS_PROJECT=nightwatch-dev

# Firebase (set GOOGLE_APPLICATION_CREDENTIALS env var to the service account JSON path)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Notifications
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
WHATSAPP_BUSINESS_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@nightwatch.ai

# Worker auth
WORKER_API_KEY=change-me-worker-secret

# Frontend dashboard base URL used in digest links and email callbacks
DASHBOARD_BASE_URL=https://nightfury-beta.vercel.app

# Live MJPEG stream (worker-hosted). Public base URL of the worker's stream
# server, and a shared HMAC secret used to sign short-lived per-camera stream
# tokens. STREAM_TOKEN_SECRET must match the worker AND relay settings.
WORKER_STREAM_URL=https://nightfury-worker.vercel.app
STREAM_TOKEN_SECRET=change-me-stream-secret
STREAM_TOKEN_TTL_SECONDS=900

# Relay WebRTC internal URL (backend proxies browser WebRTC offers to this endpoint)
RELAY_WEBRTC_URL=http://relay:9080

# Super admin (created on first run)
SUPER_ADMIN_USERNAME=nightwatch
SUPER_ADMIN_PASSWORD=change-me-on-first-login
