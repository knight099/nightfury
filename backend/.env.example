# App
APP_NAME=nightwatch-api
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# Database
DATABASE_URL=postgresql+asyncpg://nightwatch:nightwatch@localhost:5432/nightwatch

# Redis
REDIS_URL=redis://localhost:6379/0

# GCS
GCS_BUCKET=nightwatch-events
GCS_PROJECT=nightwatch-dev

# Firebase (set GOOGLE_APPLICATION_CREDENTIALS env var to the service account JSON path)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Notifications
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
WHATSAPP_BUSINESS_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@nightwatch.ai

# Worker auth
WORKER_API_KEY=change-me-worker-secret

# Super admin (created on first run)
SUPER_ADMIN_USERNAME=nightwatch
SUPER_ADMIN_PASSWORD=change-me-on-first-login
