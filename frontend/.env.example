# Nightwatch Frontend — environment template.
# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* vars are readable by the browser — never put secrets here.

# Backend REST + WebSocket base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloud relay base URL, shown to users on the device-pairing screen.
NEXT_PUBLIC_RELAY_URL=http://localhost:9080

# Base URL agent binaries are downloaded from (onboarding "install agent" step).
NEXT_PUBLIC_AGENT_DOWNLOAD_BASE_URL=https://releases.yourdomain.com/agent/latest

# Feature flag: "true" serves the V2 shell at /app and redirects all legacy
# routes to /app. Anything else (default) keeps the existing dashboard.
#
# INTERNAL DOGFOODING ONLY — do not enable in any environment real users can
# reach. While this flag is on, these existing features are NOT yet ported to
# the V2 shell and become unreachable:
#   - event list + approve/reject feedback (/events)
#   - alert rule CRUD (/alerts)
#   - camera / device pairing (/cameras/connect)
#   - the add-camera form
#   - usage page (/usage)
#   - test-camera page (/test-camera)
NEXT_PUBLIC_NEW_UI=false
