# Nightwatch LAN agent — local dev env
#
# The agent loads .env from the current working directory automatically.
# You can still export these into your shell if you prefer.

# Backend API the agent pairs/reports/discovers against.
# Defaults to the deployed Nightwatch backend if unset.
BACKEND_URL=https://nightfury-backend.vercel.app

# Cloud relay gRPC address for tunneling camera streams.
# Defaults to the production relay host in code if unset.
AGENT_RELAY_ADDR=relay.nightwatch.ai:9443

# Use an insecure (no-TLS) connection to the relay — only for local dev.
AGENT_RELAY_INSECURE=0

# Local UI address for the pairing wizard (http://localhost:8765).
AGENT_UI_ADDR=:8765

# Where the agent stores its device token + keypair. Defaults to
# /var/lib/nightwatch-agent, which usually needs root — use a local dir for dev.
AGENT_STATE_DIR=./state

# Preconfigured bootstrap mode:
# If you already have a device token issued by Nightwatch, set these values
# and the agent will skip pairing entirely and bind itself to that org + agent.
AGENT_DEVICE_TOKEN=
AGENT_ORG_ID=
AGENT_ID=

# One-time code used only by the account-bound download installer. Do not set
# this manually; it expires after 10 minutes and is consumed on first start.
AGENT_PAIR_CODE=
# Optional explicit relay URL to store alongside a pre-issued token.
AGENT_RELAY_URL=

# Optional static agent key (legacy alternative to pairing flow), leave unset
# for the normal pairing-code flow.
AGENT_KEY=
