# Nightwatch LAN agent — local dev env
#
# The agent binary does not auto-load this file (no dotenv in Go code).
# Before running, export these into your shell, e.g.:
#   set -a; source .env; set +a; ./nightwatch-agent

# Backend API the agent pairs/reports/discovers against.
# Defaults to https://api.nightwatch.local (prod placeholder) if unset.
BACKEND_URL=http://localhost:8080

# Cloud relay gRPC address for tunneling camera streams.
AGENT_RELAY_ADDR=localhost:9443

# Use an insecure (no-TLS) connection to the relay — only for local dev.
AGENT_RELAY_INSECURE=1

# Local UI address for the pairing wizard (http://localhost:8765).
AGENT_UI_ADDR=:8765

# Where the agent stores its device token + keypair. Defaults to
# /var/lib/nightwatch-agent, which usually needs root — use a local dir for dev.
AGENT_STATE_DIR=./state

# Optional static agent key (alternative to pairing flow), leave unset for
# the normal pairing-code flow.
AGENT_KEY=
