# Backend API
BACKEND_URL=http://localhost:8080
WORKER_API_KEY=change-me-worker-secret

# GCS
GCS_BUCKET=nightwatch-events
GCS_PROJECT=nightwatch-dev
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini
GEMINI_MODEL=gemini-2.0-flash
# Fallback used if Vertex AI ADC auth fails (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Worker identity
WORKER_ID=worker-01
MAX_CAMERAS=12

# Camera config file
CAMERAS_CONFIG=cameras.json

# Live MJPEG stream server (multipart/x-mixed-replace)
MJPEG_SERVER_ENABLED=true
MJPEG_SERVER_HOST=0.0.0.0
MJPEG_SERVER_PORT=8090
MJPEG_FPS=10
MJPEG_QUALITY=80

# Shared HMAC secret used to verify stream tokens issued by the backend's
# /api/cameras/{id}/stream-url endpoint. Must match backend's
# STREAM_TOKEN_SECRET. Leave empty to disable auth (local dev only).
STREAM_TOKEN_SECRET=change-me-stream-secret
