# Backend API
BACKEND_URL=http://localhost:8080
WORKER_API_KEY=change-me-worker-secret

# GCS
GCS_BUCKET=nightwatch-events
GCS_PROJECT=nightwatch-dev
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini
GEMINI_MODEL=gemini-2.0-flash
# Fallback used if Vertex AI ADC auth fails (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Worker identity
WORKER_ID=worker-01
MAX_CAMERAS=12

# Camera config file
CAMERAS_CONFIG=cameras.json
