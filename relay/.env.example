# Relay service environment variables

# Listen addresses
RELAY_GRPC_ADDR=:9443
RELAY_RTSP_ADDR=:8554
RELAY_WEBRTC_ADDR=:9080

# Auth
RELAY_AGENT_KEY=                     # static agent key (dev only; use device tokens in prod)
RELAY_BACKEND_URL=http://localhost:8080
RELAY_WORKER_KEY=change-me-worker-secret

# STREAM_TOKEN_SECRET must match the backend's STREAM_TOKEN_SECRET.
# Used to validate short-lived view tokens on the /view endpoint.
STREAM_TOKEN_SECRET=change-me-stream-secret
