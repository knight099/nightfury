{
  "name": "@nightwatch/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone snapshot of Nightwatch's real UI components and design tokens, for use with design-sync.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:fonts",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css",
    "build:fonts": "mkdir -p dist/files && cp node_modules/@fontsource/inter/files/*.woff* node_modules/@fontsource/space-grotesk/files/*.woff* node_modules/@fontsource/jetbrains-mono/files/*.woff* dist/files/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.16.0",
    "zustand": "^5.0.13",
    "@tanstack/react-query": "^5.100.14",
    "date-fns": "^4.3.0",
    "driver.js": "^1.4.0",
    "@base-ui/react": "^1.5.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/cli": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "tsup": "^8.3.0",
    "typescript": "^5"
  }
}
